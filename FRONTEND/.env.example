# ── Frontend (VITE_*: se incluyen en el código público; nunca poner secretos aquí) ──
VITE_API_URL=/api/v1

# Analítica (opcionales; sin ellos no se carga ningún script). No inventar IDs.
# Google Tag Manager, p. ej. GTM-XXXXXXX
VITE_GTM_ID=
# Google Analytics 4, p. ej. G-XXXXXXXXXX (si no se usa GTM)
VITE_GA_ID=
# Meta Pixel (solo números), para los anuncios de Facebook e Instagram
VITE_META_PIXEL_ID=

# ── Función de contacto en Vercel (secretos: configurarlos en Vercel, no en este archivo) ──
# SMTP_USER=abogados@orionlex.co
# SMTP_PASS=contraseña-del-correo
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# CONTACT_TO=abogados@orionlex.co
