# ── Frontend (VITE_*: se incluyen en el código público; nunca poner secretos aquí) ──
VITE_API_URL=/api/v1

# Analítica (opcionales; sin ellos no se carga ningún script). No inventar IDs.
# Google Tag Manager, p. ej. GTM-XXXXXXX
VITE_GTM_ID=
# Google Analytics 4, p. ej. G-XXXXXXXXXX (si no se usa GTM)
VITE_GA_ID=
# Meta Pixel (solo números), para los anuncios de Facebook e Instagram
VITE_META_PIXEL_ID=

# ── Función de contacto en Vercel (secretos: configurarlos en Vercel, no en este archivo) ──
# SMTP_USER=abogados@orionlex.co
# SMTP_PASS=contraseña-del-correo
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# CONTACT_TO=abogados@orionlex.co

# ── Panel de administración /admin (secretos: en Vercel y en FRONTEND/.env.local, nunca aquí) ──
# Huella de la contraseña y clave de sesión: npm run admin:password -w FRONTEND -- "contraseña"
# ADMIN_EMAIL=abogados@orionlex.co
# ADMIN_NAME=Nombre Apellido
# ADMIN_ROLE=Administradora
# ADMIN_PASSWORD_HASH=scrypt:16384:8:1:...
# ADMIN_SESSION_SECRET=(32 caracteres o más)
# Solo en Vercel: el panel guarda cada cambio como un commit en GitHub (token "fine-grained" con
# permiso Contents: Read and write sobre orionlexsas/ORION_LEX). En local se guarda en el disco.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=orionlexsas/ORION_LEX
# GITHUB_BRANCH=main
